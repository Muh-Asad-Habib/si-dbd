# Connection string Neon Postgres (Dashboard Neon > Connect)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Kata sandi login dashboard petugas
ADMIN_PASSWORD=ganti-dengan-password-kuat

# String acak panjang untuk menandatangani cookie admin
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=ganti-dengan-string-acak-panjang

# Segmen URL rahasia dashboard petugas (tanpa garis miring). Dashboard di /<ADMIN_PATH>
# /admin langsung akan menampilkan 404. Buat acak, jangan disebar.
ADMIN_PATH=petugas-ganti-dengan-acak
